<Window x:Class="efficiencyCalculator.View.InfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:efficiencyCalculator.View"
        mc:Ignorable="d"
        Title="O aplikaciji" Height="620" Width="400"
        BorderBrush="Orange" BorderThickness="1.5"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource windowBackground}" Foreground="{DynamicResource windowForeground}">
    <Grid>
        <TextBlock HorizontalAlignment="Center" FontSize="21" FontWeight="SemiBold" Text="Objašnjenje energetskih klasa" Margin="30" VerticalAlignment="Top"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Width="auto" Height="auto" Margin="20,70,20,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*"/>
                    <ColumnDefinition Width="50*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <Image HorizontalAlignment="Center" Height="230" Grid.Row="1" Grid.RowSpan="2"  Source="/Resources/Images/newLabel.jpg"/>
                <TextBlock  HorizontalAlignment="Center" TextAlignment="Justify" TextWrapping="Wrap" Text="Od 2021. godine Evropska unija koristi novu skalu energetskih klasa za kućanske uređaje, kako bi se potrošačima pružila jasnija i stroža ocjena energetske efikasnosti. Skala sada ide od klase A (najefikasnija) do klase G (najslabija), te su time zamijenjene prethodne oznake A+, A++ itd.  sa više pluseva koji su otežavali donošenje najbolje odluke za krajnjeg potrošača." VerticalAlignment="Center" Grid.ColumnSpan="2" FontSize="13"/>
                <TextBlock Margin="3" Grid.Column="1" TextAlignment="Justify" HorizontalAlignment="Center" Grid.Row="1" TextWrapping="Wrap" Text="Na etiketi se prikazuje energetska klasa odgovarajuće boje, godišnja potrošnja el. energije u kWh i dodatne kriterijume koji su specifični za tim uređaja, npr. kapacitet odjeljaka frižidera ili zamrzivača u litrima i nivo buke pri radu motora u dB. Ova klasifikacija omogućava lakše poređenje uređaja i podstiče izbor energetski efikasnijih modela. Uređaji koji su ranije bili A++ sada mogu biti svrstani u klasu C ili D, jer su kriteriji znatno pooštreni." VerticalAlignment="Center" Grid.RowSpan="2"/>
                <TextBlock TextAlignment="Justify" HorizontalAlignment="Center" Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap" VerticalAlignment="Top" Margin="0,10">
                    <Run  Text="Za detaljnije objašnjenje kriterijuma energetske efikasnosti po tipovima uređaja u domaćinstvu posjetite zvaničnu web stranicu Evropske Unije: "/>
                    <Hyperlink TextDecorations="None" RequestNavigate="Hyperlink_RequestNavigate" NavigateUri="https://energy-efficient-products.ec.europa.eu/product-list_en">
                        EU Energy Efficient Products
                    </Hyperlink>
                </TextBlock>
                <Button  Content="Razumijem" Width="100" Cursor="Hand" Height="30" FontSize="14" HorizontalAlignment="Center" Grid.ColumnSpan="2" Grid.Row="4" VerticalAlignment="Center" Click="Button_Click"/>
            </Grid>
        </ScrollViewer>

    </Grid>
</Window>
